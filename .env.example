# Copy to .env and adjust as needed: cp .env.example .env

# Host port the web UI is published on
PORT=8570

# If set, the browser asks for this password (HTTP Basic, any username).
# Leave empty to disable authentication.
APP_PASSWORD=

# Pin the printer device, e.g. /dev/usb/lp0. Leave empty for auto-detection.
QL_DEVICE=

# GID of the "lp" group on the host (check with: getent group lp)
LP_GID=7
